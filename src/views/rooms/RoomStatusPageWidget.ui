   <string notr="true">
RoomStatusPageWidget {
    background-color: transparent;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}

QScrollArea QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}

/* Base text color */
QLabel, QCheckBox, QRadioButton {
    color: #2B3674;
}

/* Filter buttons (All Room, Standard, etc.) */
QPushButton#btnFilterAll, QPushButton#btnFilterStandard, QPushButton#btnFilterDeluxe, QPushButton#btnFilterSuite {
    background-color: #F0F4F8;
    color: #005BFE;
    border: 1px solid #D9E2EC;
    border-radius: 15px; /* Rounded corners */
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton#btnFilterAll:hover, QPushButton#btnFilterStandard:hover, QPushButton#btnFilterDeluxe:hover, QPushButton#btnFilterSuite:hover {
    background-color: #E2E8F0;
}
QPushButton#btnFilterAll:checked, QPushButton#btnFilterStandard:checked, QPushButton#btnFilterDeluxe:checked, QPushButton#btnFilterSuite:checked {
    background-color: #005BFE;
    color: #FFFFFF;
}

/* Search Bar */
QLineEdit#txtSearchRoom {
    background-color: #FFFFFF;
    border: 1px solid #a8a8a8;
    border-radius: 15px;
    padding: 4px 15px;
    color: #333333;
}
QLineEdit#txtSearchRoom:focus {
    border: 1px solid #005BFE;
}

/* Search Frame */
QFrame#frameFilterPanel {
    background-color: #FFFFFF;
    border-radius: 15px;
    border: none;
}

/* Increment/Decrement Buttons */
QPushButton#btnAddAdult, QPushButton#btnMinusAdult, QPushButton#btnAddChild, QPushButton#btnMinusChild {
    background-color: #FFFFFF;
    color: #005BFE;
    border: 1px solid #005BFE;
    border-radius: 12px;
    font-weight: bold;
    font-size: 16px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
}
QPushButton#btnAddAdult:hover, QPushButton#btnMinusAdult:hover, QPushButton#btnAddChild:hover, QPushButton#btnMinusChild:hover {
    background-color: #E2E8F0;
}

/* Check Availability Button */
QPushButton#btnCheckAvailability {
    background-color: #005BFE;
    color: white;
    border-radius: 10px;
    padding: 10px;
    font-weight: bold;
}
QPushButton#btnCheckAvailability:hover {
    background-color: #0044CC;
}
QPushButton#btnCheckAvailability:pressed {
    background-color: #003399;
    padding-top: 12px;
    padding-left: 12px;
    padding-bottom: 8px;
    padding-right: 8px;
}
/* Date input - large, clear white container */
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 12px;
    color: #333333;
    font-size: 14px;
}
QDateEdit::up-button, QDateEdit::down-button {
    width: 0px;
    border: none;
}


/* Modified: match the shared rounded scrollbar treatment used across operational pages. */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 12px;
    margin: 5px 3px 5px 0px;
}
QScrollBar::handle:vertical {
    background: #C7D3E3;
    border: 2px solid transparent;
    min-height: 34px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #94A9C2;
}
QScrollBar::handle:vertical:pressed {
    background: #6E86A3;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QLabel {
    background-color: transparent;
}</string>
