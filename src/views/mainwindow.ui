  <property name="styleSheet">
   <string notr="true">/* ================= 1. CẤU TRÚC NỀN (Đã fix lỗi góc bo) ================= */
QWidget#centralwidget {
    background-color: #E5E7EB; /* Xám bọc ngoài */
}

QFrame#mainAppContainer {
    background-color: #FFFFFF;
    border-radius: 24px;
}

/* Kẻ viền mờ và ép góc bo tròn cho mép trái của Menu để không lòi góc nhọn */
QFrame#sidebarFrame {
    border-right: 2px solid #F1F5F9;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
}

QFrame#headerFrame {
    border-bottom: 2px solid #F1F5F9;
}

/* Đảm bảo phần ruột trong suốt để ăn theo nền trắng của mainAppContainer */
QFrame#mainContentFrame, QStackedWidget {
        background-color: #FFFFFF;
    border-radius: 24px;
         border: 1px solid #E5E7EB;
}

QPushButton[sidebarBtn=&quot;true&quot;] {
    background-color: transparent;
    color: #A3AED0; /* Màu chữ xám khi Inactive */
    border: none;
    text-align: left;
    padding-left: 20px;
    font-size: 14px;
    font-weight: 600;
    min-height: 45px;
    border-radius: 10px;
}

/* Hiệu ứng khi rê chuột vào */
QPushButton[sidebarBtn=&quot;true&quot;]:hover {
    background-color: #F4F7FE;
    color: #005BFE;
}

/* Style khi nút được kích hoạt (Active) */
QPushButton[sidebarBtn=&quot;true&quot;][active=&quot;true&quot;] {
    background-color: #005BFE; /* Màu xanh chủ đạo */
    color: #FFFFFF; /* Chữ trắng */
}


/* ================= 3. HEADER BÊN PHẢI (Tiêu đề) ================= */
/* Chữ Hello Jack */
QLabel#lblWelcome {
    color: #2B3674;
    font-size: 26px;
    font-weight: 900; /* In đậm cực mạnh */
    padding-left: 25px; /* Thụt lề cho bằng với thẻ phòng ở dưới */
    padding-top: 15px;
}

/* Chữ Ngày tháng */
QLabel#lblDate {
    color: #A3AED0;
    font-size: 14px;
    font-weight: bold;
    padding-left: 25px;
    padding-bottom: 15px;
}

/* ================= 4. STYLE CHO HỘP THOẠI THÔNG BÁO (QMessageBox) ================= */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #2B3674;
    font-size: 13px;
    font-weight: 500;
}

QMessageBox QPushButton {
    background-color: #005BFE;
    color: #FFFFFF;
    font-weight: 700;
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 12px;
    border: none;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #2B7BFF;
}</string>
