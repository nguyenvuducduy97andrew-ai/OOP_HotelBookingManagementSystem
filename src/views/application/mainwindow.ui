  <property name="styleSheet">
   <string notr="true">/* ================= 1. BASE STRUCTURE (rounded-corner fix) ================= */
QWidget#centralwidget {
    background-color: #E5E7EB; /* Outer gray background */
}

QFrame#mainAppContainer {
    background-color: #FFFFFF;
    border-radius: 24px;
}

/* Add a subtle border and rounded left menu corners to avoid sharp edges. */
QFrame#sidebarFrame {
    border-right: 2px solid #F1F5F9;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
}

QFrame#headerFrame {
    border-bottom: 2px solid #F1F5F9;
}

/* Keep the inner area transparent so it inherits mainAppContainer's white background. */
QFrame#mainContainFrame, QStackedWidget {
        background-color: #FFFFFF;
    border-radius: 24px;
         border: none;
}

QPushButton[sidebarBtn=&quot;true&quot;] {
    background-color: transparent;
    color: #A3AED0; /* Gray text while inactive */
    border: none;
    text-align: left;
    padding-left: 20px;
    font-size: 14px;
    font-weight: 600;
    min-height: 45px;
    border-radius: 10px;
}

/* Hover state */
QPushButton[sidebarBtn=&quot;true&quot;]:hover {
    background-color: #F4F7FE;
    color: #005BFE;
}

/* Active button style */
QPushButton[sidebarBtn=&quot;true&quot;][active=&quot;true&quot;] {
    background-color: #005BFE; /* Primary blue */
    color: #FFFFFF; /* White text */
}


/* ================= 3. RIGHT HEADER (title) ================= */
/* "Hello Jack" label */
QLabel#lblWelcome {
    color: #2B3674;
    font-size: 26px;
    font-weight: 900; /* Extra-bold */
    padding-left: 25px; /* Align with the room cards below */
    padding-top: 15px;
}

/* Date label */
QLabel#lblDate {
    color: #A3AED0;
    font-size: 14px;
    font-weight: bold;
    padding-left: 0px;
    padding-bottom: 0px;
}

/* ================= 4. MESSAGE BOX STYLE (QMessageBox) ================= */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #2B3674;
    font-size: 13px;
    font-weight: 500;
}

QMessageBox QPushButton {
    background-color: #005BFE;
    color: #FFFFFF;
    font-weight: 700;
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 12px;
    border: none;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #2B7BFF;
}</string>
