  <property name="styleSheet">
   <string notr="true">
/* Dialog background */
QDialog#BookingDialog {
    background-color: #F1F5F9;
}

/* Rounded white card */
QFrame#cardFrame {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E2E8F0;
}

/* Form title */
QLabel#lblTitle {
    font-size: 24px;
    font-weight: bold;
    color: #1E293B;
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
    padding-bottom: 4px;
}

QLabel#lblSubtitle {
    font-size: 13px; /* Increased previously in C++. */
    font-weight: normal;
    color: #94A3B8;
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
}

/* Horizontal separator */
QFrame#headerLine {
    background-color: #E2E8F0;
    max-height: 1px;
    border: none;
}

/* Field labels */
QLabel#lblFullname, QLabel#lblIdNumber, QLabel#lblPhoneNumber, QLabel#lblDateIn, QLabel#lblDateOut {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    background: transparent;
    border: none;
    padding-left: 2px;
}

/* Input fields */
QLineEdit, QDateTimeEdit {
    background-color: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    padding: 10px 14px;
    color: #1E293B;
    font-size: 14px;
    min-height: 20px;
}

QLineEdit:focus, QDateTimeEdit:focus {
    border: 1.5px solid #005BFE;
    background-color: #FFFFFF;
}

QLineEdit:hover, QDateTimeEdit:hover {
    border: 1.5px solid #CBD5E1;
}

/* Hide DateTimeEdit spinner buttons */
QDateTimeEdit::up-button, QDateTimeEdit::down-button {
    width: 0px;
    border: none;
}

/* Cancel button */
QPushButton#btnCancel {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 24px;
    min-height: 20px;
}

QPushButton#btnCancel:hover {
    background-color: #E2E8F0;
    color: #475569;
    border: 1.5px solid #CBD5E1;
}

QPushButton#btnCancel:pressed {
    background-color: #CBD5E1;
}

/* Confirm button */
QPushButton#btnConfirm {
    background-color: #005BFE;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 24px;
    min-height: 20px;
}

QPushButton#btnConfirm:hover {
    background-color: #0044CC;
}

QPushButton#btnConfirm:pressed {
    background-color: #003399;
}
   </string>
